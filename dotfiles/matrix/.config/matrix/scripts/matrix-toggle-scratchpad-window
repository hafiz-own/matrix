#!/usr/bin/env bash
# DESC: Toggles the currently active window in and out of the "magic" special workspace (scratchpad)

# DESC: Toggles windows in and out of the special magic scratchpad.

# Fail fast, fail loud
set -Eeuo pipefail
trap 'echo -e "\e[31m[!] Error: Script failed on line \$LINENO\e[0m" >&2' ERR

# Standard logging functions
info()    { echo -e "\e[34m[*]\e[0m \$1"; }
warn()    { echo -e "\e[33m[!]\e[0m \$1"; }
die()     { echo -e "\e[31m[✘]\e[0m \$1" >&2; exit 1; }
success() { echo -e "\e[32m[✔]\e[0m \$1"; }

# Help Menu
show_help() {
    cat << EOF
Usage: \$(basename "\$0") [OPTIONS]

Toggles windows in and out of the special magic scratchpad.

Options:
  -h, --help    Show this help message and exit
EOF
}

if [[ "\${1:-}" == "-h" || "\${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi


# Fetch the workspace name of the currently active window
WINDOW_WORKSPACE=$(hyprctl activewindow -j | jq -r '.workspace.name')

if [[ "$WINDOW_WORKSPACE" == special:* ]]; then
    # The active window is currently in a special workspace.
    # Move it back to the active regular workspace (e+0 means the currently active workspace).
    hyprctl dispatch "hl.dsp.window.move({ workspace = 'e+0' })"
else
    # The active window is in a regular workspace.
    # Move it to the "magic" special workspace.
    hyprctl dispatch "hl.dsp.window.move({ workspace = 'special:magic' })"
fi
