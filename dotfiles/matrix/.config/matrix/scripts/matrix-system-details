#!/usr/bin/env bash
# DESC: Display detailed hardware and system information

# DESC: Prints a comprehensive hardware layout to the terminal.

# Fail fast, fail loud
set -Eeuo pipefail
trap 'echo -e "\e[31m[!] Error: Script failed on line \$LINENO\e[0m" >&2' ERR

# Standard logging functions
info()    { echo -e "\e[34m[*]\e[0m \$1"; }
warn()    { echo -e "\e[33m[!]\e[0m \$1"; }
die()     { echo -e "\e[31m[✘]\e[0m \$1" >&2; exit 1; }
success() { echo -e "\e[32m[✔]\e[0m \$1"; }

# Help Menu
show_help() {
    cat << EOF
Usage: \$(basename "\$0") [OPTIONS]

Prints a comprehensive hardware layout to the terminal.

Options:
  -h, --help    Show this help message and exit
EOF
}

if [[ "\${1:-}" == "-h" || "\${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi


set -euo pipefail
trap 'echo -e "\e[31m[!] Error on line $LINENO\e[0m" >&2' ERR

ALIAS_NAME="system-details"

show_help() {
    echo -e "Usage: \033[1;36m${ALIAS_NAME}\033[0m [COMMAND]"
    echo "Displays a comprehensive breakdown of hardware and system capabilities."
    echo ""
    echo -e "\033[1;33mCommands:\033[0m"
    echo "  (none)     Run a full system hardware scan"
    echo "  -h, --help Show this help message"
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    show_help
    exit 0
fi

if ! command -v inxi &> /dev/null; then
    echo -e "\e[31m[!] Error: 'inxi' is not installed.\e[0m"
    echo "    Please run: sudo pacman -S inxi"
    exit 1
fi

echo -e "\033[1;34m=========================================\033[0m"
echo -e "\033[1;36m       Matrix System Hardware Scan       \033[0m"
echo -e "\033[1;34m=========================================\033[0m"
echo ""

# Run inxi with full output minus sensitive data (MACs/Serial)
inxi -Fxxz
