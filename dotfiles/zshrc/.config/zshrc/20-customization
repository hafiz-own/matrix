# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------

# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

# ZSH history settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
ZSH_THEME="powerlevel10k/powerlevel10k"
