#!/usr/bin/env bash
# DESC: Run one application on the NVIDIA dGPU (PRIME render offload).
#
# The session only exposes the Intel Vulkan driver (VK_DRIVER_FILES in
# hypr/conf/environments/default.lua) so idle apps never wake the dGPU.
# and Hyprland only exposes Mesa EGL (matrix-start-hyprland). This wrapper
# flips both for the launched command: NVIDIA Vulkan driver, NVIDIA
# GLX/EGL via PRIME offload.
#
# Usage:   use-gpu <command> [args...]          (zsh alias)
#          ~/.config/matrix/scripts/matrix-use-gpu <command>   (anywhere)
# Steam:   ~/.config/matrix/scripts/matrix-use-gpu %command%

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: use-gpu <command> [arguments...]"
    echo "Runs the command on the NVIDIA dGPU (PRIME offload, GL + Vulkan)."
    echo "Examples: use-gpu vkcube   use-gpu glxinfo -B   use-gpu blender"
    exit 0
fi

if [[ ! -d /sys/module/nvidia ]]; then
    echo "[ERROR] NVIDIA driver is not loaded." >&2
    exit 1
fi

export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json:/usr/share/glvnd/egl_vendor.d/50_mesa.json
unset MESA_VK_DEVICE_SELECT
export __NV_PRIME_RENDER_OFFLOAD=1
export __VK_LAYER_NV_optimus=NVIDIA_only
export __GLX_VENDOR_LIBRARY_NAME=nvidia
exec "$@"
