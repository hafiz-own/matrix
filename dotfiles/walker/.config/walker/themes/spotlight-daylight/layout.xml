<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkWindow" id="Window">
    <style>
      <class name="window"></class>
    </style>
    <property name="resizable">true</property>
    <property name="title">Spotlight</property>
    <child>
      <object class="GtkBox" id="BoxWrapper">
        <style>
          <class name="box-wrapper"></class>
        </style>
        <property name="overflow">hidden</property>
        <property name="orientation">horizontal</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <property name="width-request">760</property>
        <child>
          <object class="GtkBox" id="Box">
            <style>
              <class name="box"></class>
            </style>
            <property name="orientation">vertical</property>
            <property name="hexpand-set">true</property>
            <property name="hexpand">true</property>
            <!-- Search bar row -->
            <child>
              <object class="GtkBox" id="SearchContainer">
                <style>
                  <class name="search-container"></class>
                </style>
                <property name="overflow">hidden</property>
                <property name="orientation">horizontal</property>
                <property name="halign">fill</property>
                <property name="hexpand-set">true</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkEntry" id="Input">
                    <style>
                      <class name="input"></class>
                    </style>
                    <property name="halign">fill</property>
                    <property name="hexpand-set">true</property>
                    <property name="hexpand">true</property>
                    <property name="width-chars">1</property>
                    <property name="max-width-chars">1</property>
                    <property name="primary-icon-name">system-search-symbolic</property>
                    <property name="placeholder-text">Search...</property>
                  </object>
                </child>
              </object>
            </child>
            <!-- Results + preview row — Walker toggles visibility of this based on results -->
            <child>
              <object class="GtkBox" id="ContentContainer">
                <style>
                  <class name="content-container"></class>
                </style>
                <property name="orientation">horizontal</property>
                <property name="spacing">0</property>

                <!-- Scroll: propagate-natural-height=true means it collapses when List is empty -->
                <child>
                  <object class="GtkScrolledWindow" id="Scroll">
                    <style>
                      <class name="scroll"></class>
                    </style>
                    <property name="can_focus">false</property>
                    <property name="overlay-scrolling">true</property>
                    <property name="hexpand">true</property>
                    <property name="max-content-height">360</property>
                    <property name="propagate-natural-height">true</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <child>
                      <object class="GtkGridView" id="List">
                        <style>
                          <class name="list"></class>
                        </style>
                        <property name="max_columns">1</property>
                        <property name="min_columns">1</property>
                        <property name="can_focus">false</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Restored Preview Pane -->
                <child>
                  <object class="GtkBox" id="Preview">
                    <style>
                      <class name="preview"></class>
                    </style>
                    <property name="visible">false</property>
                    <property name="hexpand">false</property>
                    <property name="vexpand">false</property>
                  </object>
                </child>
              </object>
            </child>
            <!-- Missing Core Objects (Required by Walker Backend) -->
            <!-- We wrap them in a permanently hidden parent container so Walker's 
                 programmatic visibility toggles (like showing 'No results' on #Placeholder) 
                 don't actually render on the screen -->
            <child>
              <object class="GtkBox" id="HiddenGarbage">
                <property name="visible">false</property>
                <child>
                  <object class="GtkLabel" id="ElephantHint">
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="Placeholder">
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="Keybinds">
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="GlobalKeybinds">
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="ItemKeybinds">
                  </object>
                </child>
              </object>
            </child>
            <!-- Error label -->
            <child>
              <object class="GtkLabel" id="Error">
                <style>
                  <class name="error"></class>
                </style>
                <property name="xalign">0</property>
                <property name="visible">false</property>
              </object>
            </child>

          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
