#!/usr/bin/env bash
# DESC: Start Hyprland on the Intel iGPU only (zsh alias: hypr).
#
# Every display output on this laptop is wired to the Intel GPU, so
# Hyprland does not need the NVIDIA dGPU. Without this, Aquamarine opens
# every DRM card at startup and the dGPU can never runtime-suspend.
# Apps can still use the dGPU on demand with `use-gpu <command>`.
#
# Card numbers (card0/card1) can swap between boots, so the Intel card is
# found by PCI vendor id each time. If it is not found, Hyprland starts
# normally. Rollback: run plain `start-hyprland` instead.
# --dry-run: print the chosen card and exit (does not start Hyprland).

for card in /sys/class/drm/card[0-9]*; do
    [[ "$card" == *-* ]] && continue          # skip connectors (card1-eDP-1)
    if [[ "$(<"$card/device/vendor")" == "0x8086" ]]; then
        export AQ_DRM_DEVICES="/dev/dri/${card##*/}"
        # libglvnd loads every EGL vendor by default; NVIDIA's EGL opens the
        # dGPU (/dev/nvidia0, its render node) even for a compositor that
        # never renders on it. Mesa only for Hyprland and everything it
        # starts; use-gpu puts NVIDIA's EGL back for the app it launches.
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
        break
    fi
done

if [[ "${1:-}" == "--dry-run" ]]; then
    echo "AQ_DRM_DEVICES=${AQ_DRM_DEVICES:-<unset: Intel card not found, would start normally>}"
    echo "__EGL_VENDOR_LIBRARY_FILENAMES=${__EGL_VENDOR_LIBRARY_FILENAMES:-<unset>}"
    exit 0
fi

exec start-hyprland "$@"
