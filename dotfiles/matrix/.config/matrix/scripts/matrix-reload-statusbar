#!/usr/bin/env bash
#  ____      _                 _   ____  _        _            _
# |  _ \ ___| | ___   __ _  __| | / ___|| |_ __ _| |_ _   _ __| |__   __ _ _ __
# | |_) / _ \ |/ _ \ / _` |/ _` | \___ \| __/ _` | __| | | / _` | '_ \ / _` | '__|
# |  _ <  __/ | (_) | (_| | (_| |  ___) | || (_| | |_| |_| \__,_| |_) | (_| | |
# |_| \_\___|_|\___/ \__,_|\__,_| |____/ \__\__,_|\__|\__,_|\__,_|_.__/ \__,_|_|
#
# ~/.config/matrix/settings/statusbar and reloads the matching bar.

# DESC: Hot-reloads the Waybar status bar seamlessly.

# Fail fast, fail loud
set -Eeuo pipefail
trap 'echo -e "\e[31m[!] Error: Script failed on line \$LINENO\e[0m" >&2' ERR

# Standard logging functions
info()    { echo -e "\e[34m[*]\e[0m \$1"; }
warn()    { echo -e "\e[33m[!]\e[0m \$1"; }
die()     { echo -e "\e[31m[✘]\e[0m \$1" >&2; exit 1; }
success() { echo -e "\e[32m[✔]\e[0m \$1"; }

# Help Menu
show_help() {
    cat << EOF
Usage: \$(basename "\$0") [OPTIONS]

Hot-reloads the Waybar status bar seamlessly.

Options:
  -h, --help    Show this help message and exit
EOF
}

if [[ "\${1:-}" == "-h" || "\${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi


settings_file="$HOME/.config/matrix/settings/statusbar"

# Default to waybar if no setting file is present.
statusbar="waybar"
if [ -f "$settings_file" ]; then
    statusbar=$(tr -d '[:space:]' < "$settings_file")
fi

case "$statusbar" in
    quickshell)
        qs ipc call statusbar reload
        ;;
    waybar)
        "$HOME/.config/waybar/launch.sh"
        ;;
    *)
        echo "Unknown statusbar '$statusbar' in $settings_file" >&2
        exit 1
        ;;
esac
